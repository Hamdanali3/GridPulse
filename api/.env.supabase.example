# ============================================================================
# GridPulse API - Supabase PostgreSQL Connection Settings
# ============================================================================

APP_NAME=GridPulse
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_URL=https://your-api-domain.onrender.com

# Allowed frontend origins for CORS (include your local Vite and Vercel domains)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# ----------------------------------------------------------------------------
# Option 1: Full Connection URI from Supabase (Recommended)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection URI
# Note: Use the "Transaction" or "Session" pooler URI or Direct connection.
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# ----------------------------------------------------------------------------
DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ----------------------------------------------------------------------------
# Option 2: Individual variables
# ----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-db-password
DB_SSLMODE=require

# ----------------------------------------------------------------------------
# Application configuration
# ----------------------------------------------------------------------------
SEED_DEMO=true
SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
