# Copy to `supabase/.env.local` (git-ignored) for local Edge Function development:
#   npx supabase functions serve --env-file supabase/.env.local
#
# In production, store secrets in Supabase (NEVER in Vercel or client VITE_* vars):
#   npx supabase secrets set GROQ_API_KEY=gsk_... GROQ_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ALLOWED_ORIGINS=https://grid-pulse-ruby.vercel.app,http://localhost:3000,http://localhost:5173
IP_HASH_SALT=gridpulse-pulsebot-v1

